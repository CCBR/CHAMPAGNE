nextflow_process {
    name "Test Process FILTER_QUALITY"
    script "../main.nf"
    process "FILTER_QUALITY"
    config "tests/nextflow_stub.config"
    tag "modules_local"
    tag "modules"
    tag "stub"
    test("Stub: preserve alignment metadata and emit a filtered BAM") {
        options "-stub-run"
        when {
            process {
                """
                input[0] = [[id: 'sample', single_end: false], file("\$projectDir/tests/test_data/alignments.sam"), []]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam[0][0] == [id: 'sample', single_end: false] },
                { assert path(process.out.bam[0][1]).fileName.toString() == 'alignments.filtered.bam' }
            )
        }
    }
}
