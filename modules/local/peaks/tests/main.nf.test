nextflow_process {
    name "Test Process MACS_NARROW"
    script "../../peaks.nf"
    process "MACS_NARROW"
    config "tests/nextflow_stub.config"
    tag "modules_local"
    tag "modules"
    tag "stub"
    test("Stub: label narrow peaks, summits, and statistics with the caller") {
        options "-stub-run"
        when {
            process {
                """
                input[0] = [[id: 'sample'], file("\$projectDir/tests/test_data/alignments.sam"), [], 'BAMPE', 150, 0.8, 1000]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.peak[0][0] == [id: 'sample'] },
                { assert process.out.peak[0][2] == 'macs_narrow' },
                { assert path(process.out.peak[0][1]).fileName.toString() == 'sample_peaks.narrowPeak' },
                { assert path(process.out.xls[0][1]).fileName.toString() == 'sample_peaks.xls' },
                { assert path(process.out.summits[0][1]).fileName.toString() == 'sample_summits.bed' }
            )
        }
    }
}
