nextflow_process {
    name "Test Process MACS2_DEDUP"
    script "../../deduplicate.nf"
    process "MACS2_DEDUP"
    config "tests/nextflow_stub.config"
    tag "modules_local"
    tag "modules"
    tag "stub"
    test("Stub: emit matching BED and BAM outputs for a single-end sample") {
        options "-stub-run"
        when {
            process {
                """
                def sizes = file("$outputDir/genome.sizes")
                sizes.text = 'chr1\\t1000\\n'
                input[0] = [[id: 'sample', single_end: true], file("\$projectDir/tests/test_data/alignments.sam"), sizes, 1000]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam[0][0] == process.out.bed[0][0] },
                { assert process.out.bam[0][0].id == 'sample' },
                { assert path(process.out.bam[0][1]).fileName.toString() == 'sample.TagAlign.dedup.bam' },
                { assert path(process.out.bed[0][1]).fileName.toString() == 'sample.TagAlign.dedup.bed' }
            )
        }
    }
}
