nextflow_process {
    name "Test Process BAM_COVERAGE"
    script "../main.nf"
    process "BAM_COVERAGE"
    config "tests/nextflow_stub.config"
    tag "modules_local"
    tag "modules"
    tag "stub"
    test("Stub: retain sample metadata on normalized coverage tracks") {
        options "-stub-run"
        when {
            process {
                """
                input[0] = [[id: 'sample', single_end: true], file("\$projectDir/tests/test_data/alignments.sam"), [], 'RPGC', 1.0, 150, 1000]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bigwig[0][0] == [id: 'sample', single_end: true] },
                { assert path(process.out.bigwig[0][1]).fileName.toString() == 'sample.bw' }
            )
        }
    }
}
