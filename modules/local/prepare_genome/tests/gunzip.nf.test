nextflow_process {

    name "Test Process GUNZIP_REFERENCE"
    script "../../prepare_genome.nf"
    process "GUNZIP_REFERENCE"
    tag "prepare_genome"
    tag "modules_local"
    tag "modules"

    test("Decompress a reference without changing sequence contents") {
        when {
            process {
                """
                def compressed = file("$outputDir/genome.fa.gz")
                new java.util.zip.GZIPOutputStream(compressed.newOutputStream()).withCloseable { stream ->
                    stream.write(file("\$projectDir/tests/test_data/genome.fa").bytes)
                }
                input[0] = compressed
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.uncompressed[0]).fileName.toString() == 'genome.fa' },
                { assert path(process.out.uncompressed[0]).text == path("$projectDir/tests/test_data/genome.fa").text }
            )
        }
    }
}
