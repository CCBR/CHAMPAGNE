nextflow_process {
    name "Test Process MACS2_DEDUP (real)"
    script "../main.nf"
    process "MACS2_DEDUP"
    tag "modules_local"
    tag "modules"
    tag "real"
    test("Deduplicate a tiny alignment and produce genomic BED and BAM records") {
        setup {
            run("SAMTOOLS_SORT") {
                script "modules/CCBR/samtools/sort/main.nf"
                process {
                    """
                    def alignments = file("$outputDir/input.sam")
                    alignments.text = '@HD\\tVN:1.6\\tSO:unsorted\\n@SQ\\tSN:chr1\\tLN:10000\\n' + (0..<2000).collect { read -> "read\${read}\\t0\\tchr1\\t\${101 + read * 4}\\t60\\t8M\\t*\\t0\\t0\\tACGTACGT\\tIIIIIIII" }.join('\\n') + '\\n'
                    input[0] = [[id: 'single', single_end: true], alignments]
                    """
                }
            }
        }
        when {
            process {
                """
                def sizes = file("$outputDir/genome.sizes")
                sizes.text = 'chr1\\t10000\\n'
                input[0] = SAMTOOLS_SORT.out.bam.map { meta, bam, bai -> [meta, bam, sizes, 10000] }
                """
            }
        }
        then {
            def records = path(process.out.bed[0][1]).readLines().collect { it.split('\t') }
            assertAll(
                { assert process.success },
                { assert process.out.bed[0][0] == [id: 'single', single_end: true] },
                { assert records.size() == 2000 },
                { assert records.every { it[0] == 'chr1' && it[1].toInteger() >= 0 && it[2].toInteger() <= 10000 } },
                { assert records.collect { it[1].toInteger() }.sort() == (0..<2000).collect { 100 + it * 4 } },
                { assert new java.util.zip.GZIPInputStream(path(process.out.bam[0][1]).newInputStream()).withCloseable { stream -> stream.readNBytes(4).toList() } == [66, 65, 77, 1] }
            )
        }
    }
}
