nextflow_process {
    name "Test Process HOMER_MOTIFS (real)"
    script "../main.nf"
    process "HOMER_MOTIFS"
    tag "modules_local"
    tag "modules"
    tag "real"
    test("Run known-motif enrichment on a tiny synthetic reference") {
        when {
            process {
                """
                def random = new Random(42)
                def genome = file("$outputDir/genome.fa")
                genome.text = '>chr1\\n' + (0..<20000).collect { 'ACGT'[random.nextInt(4)] }.join('') + '\\n'
                def peaks = file("$outputDir/peaks.bed")
                peaks.text = (0..<30).collect { peak -> "chr1\\t\${1000 + peak * 500}\\t\${1100 + peak * 500}\\tpeak\${peak}" }.join('\\n') + '\\n'
                def motifs = file("$outputDir/test.motif")
                motifs.text = '>ACGTGC\\ttest\\t1\\n0.97\\t0.01\\t0.01\\t0.01\\n0.01\\t0.97\\t0.01\\t0.01\\n0.01\\t0.01\\t0.97\\t0.01\\n0.01\\t0.01\\t0.01\\t0.97\\n0.01\\t0.01\\t0.97\\t0.01\\n0.01\\t0.97\\t0.01\\t0.01\\n'
                input[0] = [[id: 'tiny'], peaks, genome, motifs]
                input[1] = false
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.motifs[0][0] == [id: 'tiny'] },
                { assert path(process.out.ame[0][1]).text.contains('>') },
                { assert path(process.out.ame[0][2]).text.count('>') == 30 },
                { assert process.out.motifs[0][1].any { path(it).fileName.toString() == 'knownResults.txt' } }
            )
        }
    }
}
