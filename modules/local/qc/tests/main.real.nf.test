nextflow_process {
    name "Test Process FASTQC (real)"
    script "../../qc.nf"
    process "FASTQC"
    tag "modules_local"
    tag "modules"
    tag "real"
    test("Analyze a tiny FASTQ and report its read count and sequence length") {
        when {
            process {
                """
                input[0] = [[id: 'tiny'], [file("\$projectDir/tests/test_data/reads_1.fastq")], 'raw']
                """
            }
        }
        then {
            def report = new java.util.zip.ZipFile(path(process.out.zip[0]).toFile()).withCloseable { archive ->
                def entry = archive.entries().find { it.name.endsWith('/fastqc_data.txt') }
                archive.getInputStream(entry).withCloseable { stream -> stream.text }
            }
            assertAll(
                { assert process.success },
                { assert path(process.out.html[0]).size() > 0 },
                { assert report.contains('Total Sequences\t1') },
                { assert report.contains('Sequence length\t8') }
            )
        }
    }
}
