nextflow_process {

    name "Test Process BAM_TO_BED"
    script "../../bedtools.nf"
    process "BAM_TO_BED"
    tag "bedtools"
    tag "modules_local"
    tag "modules"

    test("Convert mapped reads to zero-based BED coordinates and strand") {
        setup {
            run("SAMTOOLS_SORT") {
                script "modules/CCBR/samtools/sort/main.nf"
                process {
                    """
                    input[0] = [[id: 'test', single_end: false], file("\$projectDir/tests/test_data/alignments.sam", checkIfExists: true)]
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam.map { meta, bam, bai -> [meta, bam] }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.bed[0][0] == [id: 'test', single_end: false] },
                { assert path(process.out.bed[0][1]).readLines() == [
                    'chr1\t100\t108\tpair/1\t60\t+',
                    'chr1\t150\t158\tpair/2\t60\t-',
                    'chr1\t200\t208\tlow/1\t20\t+',
                    'chr1\t250\t258\tlow/2\t20\t-',
                    'chr1\t300\t308\tsingle\t60\t+'
                ] }
            )
        }
    }
}
