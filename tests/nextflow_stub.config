process {
    withName: '.*' {
        container = 'community.wave.seqera.io/library/coreutils_grep_gzip_lbzip2_pruned:838ba80435a629f8'
        cpus = 1
        memory = 1.GB
        time = 1.h
    }
    withName: '.*SAMTOOLS_.*' {
        container = 'nciccbr/ccbr_ubuntu_base_20.04:v6'
    }
    withName: '.*DIFFBIND_RMD' {
        container = 'nciccbr/ccbr_diffbind:v1'
    }
}
