nextflow_workflow {
    name "Test Workflow ANNOTATE"
    script "../../annotate.nf"
    workflow "ANNOTATE"
    config "tests/nextflow_stub.config"
    tag "subworkflows_local"
    tag "subworkflows"
    tag "stub"
    test("Stub: group annotation results into a consensus summary plot") {
        options "-stub-run"
        when {
            workflow {
                """
                input[0] = Channel.of([[id: 'sample', tool: 'macs_narrow', consensus: 'corces'], file("\$projectDir/tests/test_data/genome.fa")])
                input[1] = Channel.value('TxDb.test')
                input[2] = Channel.value('org.test.db')
                input[3] = true
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.annot.size() == 1 },
                { assert workflow.out.annot[0][0].consensus == 'corces' },
                { assert path(workflow.out.annot[0][1]).fileName.toString() == 'sample.annotation.Rds' },
                { assert workflow.out.plots.flatten().collect { path(it).fileName.toString() } == ['corces_plot_anno_bar.png'] }
            )
        }
    }
}
